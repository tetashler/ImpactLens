# Copy to .env.local and fill in privately.
# OneMap token may expire; renew and replace manually when needed.
ONEMAP_API_KEY=
LTA_DATAMALL_API_KEY=
GEMINI_API_KEY=
# AI remains unavailable until a provider, its API key, and an explicit model ID are set.
# Keep these server-only: do not prefix any AI setting with NEXT_PUBLIC_.
AI_PROVIDER=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Direct Claude API: set AI_PROVIDER=anthropic and enter your private key.
# New scenario planning, agent decisions and reports use Claude Haiku 5.5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional speech input: a dedicated server-only key enables Whisper transcription.
# No fallback to OPENROUTER_API_KEY. Never use a NEXT_PUBLIC_ prefix.
OPENROUTER_STT_API_KEY=
# Optional: whole-request deadline (1..120000 ms) and output budget (1..16384 tokens).
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024

# Both switches must be true for AI follow-up discussion; enabling planning alone
# still permits rule-only background activity. Keep credentials server-only.
STAKEHOLDER_LIVE_ENABLED=false
SOCIAL_LLM_ENABLED=false
SOCIAL_SWARM_SIZE=50
# Total social AI call cap; planning, retrieval and report writing are separate.
SOCIAL_PROVIDER_MAX_CALLS=30

# Optional private runtime directories. Defaults remain inside the local project.
# Persistent Linux deployment uses absolute paths outside the checkout;
# see docs/SINGLE_INSTANCE_DEPLOYMENT.md and deploy/impactlens.env.example.
# SOCIAL_STORAGE_ROOT=/absolute/private/path/simulations
# POPULATION_STORAGE_ROOT=/absolute/private/path/populations
# CITIZEN_DATASET_ROOT=/absolute/private/path/citizens
