# systemd EnvironmentFile syntax: literal KEY=value, no export or shell expansion.
# Install a private copy at /etc/impactlens/impactlens.env (root-owned, mode 0600).
IMPACTLENS_NODE_BINARY=/usr/bin/node
IMPACTLENS_STATE_DIRECTORY=/var/lib/impactlens
SOCIAL_STORAGE_ROOT=/var/lib/impactlens/simulations
POPULATION_STORAGE_ROOT=/var/lib/impactlens/populations
CITIZEN_DATASET_ROOT=/var/lib/impactlens/citizens
# Optional finite private prose diagnostics; leave unset unless needed.
# SOCIAL_PROSE_OBSERVATION_ROOT=/var/lib/impactlens/observations
PORT=3000
# Keep optional paid features disabled until the operator configures them.
AI_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_STT_API_KEY=
TAVILY_API_KEY=
STAKEHOLDER_LIVE_ENABLED=false
SOCIAL_LLM_ENABLED=false
SOCIAL_SWARM_SIZE=50
SOCIAL_PROVIDER_MAX_CALLS=30
